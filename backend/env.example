# --- API ---
PORT=4000
# Allowed browser origin(s), comma separated
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/cybersentinel?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Fast decision model (System 1) ---
# Leave empty to run in DEMO FIXTURE mode; the UI will say so.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/complete
JEV_MODEL=typesafe-jev-1

# --- Deep reasoning model (System 2) ---
# Leave empty to run in DEMO FIXTURE mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Routing thresholds (optional overrides) ---
CONTAIN_THRESHOLD=0.95
DISMISS_THRESHOLD=0.40
